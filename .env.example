# --- Supabase PostgreSQL (current setup) ---
# Runtime via pooler (PgBouncer transaction mode). The password contains "@",
# percent-encoded as %40 — required for URL parsing.
DATABASE_URL="postgresql://postgres.<project-ref>:<password-with-%40-for-@>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations via pooler in session mode (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password-with-%40-for-@>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js secret — generate a fresh value per environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-generate-a-random-value"
